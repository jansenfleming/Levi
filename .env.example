# Copy to .env and adjust. .env is git-ignored.
# Web server (the only thing that should ever be public)
HOST=0.0.0.0
PORT=8080

# The alien's brain. Never expose this port to the internet.
# On the Pi later, point this at the PC's LAN address, e.g. http://192.168.1.50:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Town clock timezone (IANA name). Empty = system timezone.
TOWN_TZ=

# Where state, memories and logs are stored (git-ignored).
DATA_DIR=data

# DEVELOPMENT ONLY: speeds up walking, activities, needs and weather. Keep 1 in production.
SIM_SPEED=1

# WebSocket limits (watch-only clients).
MAX_CLIENTS=500
MAX_CLIENTS_PER_IP=8
